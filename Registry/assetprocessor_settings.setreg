{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder AudioEngineFMOD/Assets": {
                    "watch": "@GEMROOT:AudioEngineFMOD@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder AudioEngineFMOD/Registry": {
                    "watch": "@GEMROOT:AudioEngineFMOD@/Registry",
                    "recursive": 1,
                    "order": 102
                },
                "Exclude FMODProjectInfo": {
                    "pattern": ".*Assets\\\\/Audio\\\\/FMOD\\\\/FMODProjectInfo\\\\.json"
                },
                "RC FMOD Copy Banks for Desktop Platforms": {
                    "glob": "*/Assets/Audio/FMOD/Banks/Desktop/*.bank",
                    "params": "copy",
                    "mobile": "skip"
                },
                "RC FMOD Copy Banks for Mobile Platforms": {
                    "glob": "*/Assets/Audio/FMOD/Banks/Mobile/*.bank",
                    "params": "skip",
                    "mobile": "copy"
                },
                "RC FMODAudioControls": {
                    "pattern": "(.*libs\\\\/gameaudio\\\\/fmod\\\\/).*\\.xml",
                    "params": "copy",
                    "productAssetType": "{D59B6A2E-1BC0-488C-959B-CF27E784D1D7}"
                }
            }
        }
    }
}
